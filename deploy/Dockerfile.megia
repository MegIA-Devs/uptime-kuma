############################################
# MegIA custom build
# Single stage: git + devDeps kept for self-update capability
############################################
FROM node:22-bookworm-slim

RUN apt update && apt --yes --no-install-recommends install \
        git \
        dumb-init \
        iputils-ping \
        ca-certificates \
        curl \
        sqlite3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1

ARG BRANCH=megia-custom
RUN git clone --branch $BRANCH https://github.com/MegIA-Devs/uptime-kuma.git . && \
    git remote add upstream https://github.com/louislam/uptime-kuma.git && \
    git config user.email "devops@megia.co" && \
    git config user.name "MegIA Bot"

# All deps (including dev) — required for npm run build during self-update
RUN npm ci

RUN npm run build

RUN mkdir -p /app/data

VOLUME ["/app/data"]

EXPOSE 3001

HEALTHCHECK --interval=60s --timeout=30s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:3001/api/entry-page || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "server/server.js"]
